# ============================================================
# EMAIL PROSPECTOR - CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# --- Webhook server for n8n / direct API use ---
HOST=0.0.0.0
PORT=3000
# Optional: if set, send this as X-API-Key or Bearer token from n8n
WEBHOOK_API_KEY=
# Max JSON request size in bytes
WEBHOOK_BODY_LIMIT_BYTES=1048576
# Max parallel jobs accepted by /prospect/batch
WEBHOOK_BATCH_CONCURRENCY=2

# --- Hunter.io API (optional) ---
HUNTER_API_KEY=your_hunter_api_key_here

# --- Groq AI fallback (optional, fast fallback when scraping finds nothing) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Runtime settings ---
# Max company jobs processed in parallel
CONCURRENCY=2
# Delay between website page requests in ms
SCRAPE_DELAY_MS=2000
