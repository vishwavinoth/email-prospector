    {
      "id": "2c28467b-1cb8-49fe-98da-6931d7d94b45",
      "name": "Build Output Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        200
      ],
      "parameters": {
        "jsCode": "const result = $json.results || $json;\nconst companyName = result.companyName || '';\nconst websiteUrl = result.websiteUrl || '';\nconst gmbInfo = result.gmbInfo || '';\nconst email = result.email || '';\nconst resultKey = [companyName.toLowerCase(), websiteUrl.toLowerCase(), email.toLowerCase()].join('|');\n\nreturn [{\n  json: {\n    'Result Key': resultKey,\n    'Input Row Number': $json.inputRowNumber || '',\n    'Company Name': companyName,\n    'Website URL': websiteUrl,\n    'GMB Info': gmbInfo,\n    'Email': email,\n    'First Name': result.firstName || '',\n    'Last Name': result.lastName || '',\n    'Role / Title': result.role || '',\n    'Department': result.department || '',\n    'Confidence Score': result.confidence === null || result.confidence === undefined || result.confidence === '' ? '' : `${result.confidence}`,\n    'Verification Status': result.verifyStatus || '',\n    'Email Type': result.emailType || '',\n    'Source': result.source || '',\n    'Found At': new Date().toISOString(),\n  },\n}];"
      }
    },
