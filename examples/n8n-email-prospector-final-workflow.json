    {
      "id": "a4caefe4-dbfd-4bfe-b8ec-31e9ce8a97ff",
      "name": "Normalize Input Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        200
      ],
      "parameters": {
        "jsCode": "const companyName = `${$json['Company Name'] || $json.companyName || $json.company || $json.name || ''}`.trim();\nconst websiteUrl = `${$json['Website URL'] || $json.websiteUrl || $json.website || $json.url || ''}`.trim();\nconst gmbInfo = `${$json['GMB Info'] || $json.gmbInfo || $json.gmb || $json.notes || ''}`.trim();\nconst processed = `${$json['Processed'] || ''}`.trim().toLowerCase();\nconst processedAt = `${$json['Processed At'] || ''}`.trim();\nconst status = `${$json['Status'] || ''}`.trim().toLowerCase();\nconst skipStatuses = ['processed', 'done', 'completed', 'success'];\n\nif (processedAt || ['true', 'yes', 'y', '1'].includes(processed) || skipStatuses.includes(status)) {\n  return [];\n}\n\nif (!websiteUrl && !gmbInfo) {\n  return [];\n}\n\nreturn [{\n  json: {\n    companyName,\n    websiteUrl,\n    gmbInfo,\n    inputRowNumber: $json.row_number || '',\n  },\n}];"
      }
    },
    {
      "id": "6c2d3f06-6bca-4c05-aae8-b6e6db6f1f4a",
      "name": "Call Email Prospector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Workflow Config').first().json.prospectorUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Workflow Config').first().json.webhookApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ companyName: $json.companyName, websiteUrl: $json.websiteUrl, gmbInfo: $json.gmbInfo }) }}",
        "options": {}
      }
    },
    {
      "id": "3773d205-0f30-4654-87cb-68d020cff95d",
      "name": "Split Out Results",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        80,
        200
      ],
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      }
